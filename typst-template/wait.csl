<?xml version="1.0" encoding="utf-8"?>
<!-- Reference style of the WAIT / egpubl LaTeX template:
     superscript numeric citations, "1." labels, EG-style entries such as
     M. Levoy. Efficient ray tracing of volume data. ACM Transactions on Graphics, 9(3):245-261, July 1990. -->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0"
       demote-non-dropping-particle="never" page-range-format="expanded">
  <info>
    <title>WAIT (egpubl) numeric superscript</title>
    <id>wait-egpubl-superscript</id>
    <updated>2026-10-26T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="en">
    <terms>
      <term name="editor" form="short">
        <single>ed.</single>
        <multiple>eds.</multiple>
      </term>
    </terms>
  </locale>
  <macro name="names">
    <names variable="author">
      <name initialize-with="." and="text" delimiter=", " delimiter-precedes-last="contextual"/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>
  <macro name="editors">
    <names variable="editor">
      <name initialize-with="." and="text" delimiter=", " delimiter-precedes-last="contextual"/>
      <label form="short" prefix=", "/>
    </names>
  </macro>
  <macro name="date">
    <date variable="issued">
      <date-part name="month" suffix=" "/>
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="volume-issue-page">
    <group>
      <text variable="volume" font-weight="bold"/>
      <text variable="issue" prefix="(" suffix=")"/>
      <text variable="page" prefix=":"/>
    </group>
  </macro>
  <macro name="access">
    <choose>
      <if variable="DOI">
        <text variable="DOI" prefix="doi:"/>
      </if>
      <else-if variable="URL">
        <text variable="URL"/>
      </else-if>
    </choose>
  </macro>
  <citation>
    <layout vertical-align="sup" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>
  <bibliography second-field-align="flush">
    <layout>
      <text variable="citation-number" suffix="."/>
      <group delimiter=". " suffix=".">
        <text macro="names"/>
        <choose>
          <if type="book thesis report" match="any">
            <text variable="title" font-style="italic"/>
            <group delimiter=", ">
              <text variable="genre"/>
              <text variable="publisher"/>
              <text variable="publisher-place"/>
              <text macro="date"/>
            </group>
          </if>
          <else-if type="chapter paper-conference" match="any">
            <text variable="title"/>
            <group delimiter=", ">
              <group delimiter=" ">
                <text term="in" text-case="capitalize-first"/>
                <text variable="container-title" font-style="italic"/>
              </group>
              <text macro="editors"/>
              <text variable="page" prefix="pp. "/>
              <text variable="publisher"/>
              <text macro="date"/>
            </group>
          </else-if>
          <else-if type="article-journal article-magazine article-newspaper" match="any">
            <text variable="title"/>
            <group delimiter=", ">
              <text variable="container-title" font-style="italic"/>
              <text macro="volume-issue-page"/>
              <text macro="date"/>
            </group>
          </else-if>
          <else>
            <text variable="title"/>
            <group delimiter=", ">
              <text variable="container-title" font-style="italic"/>
              <text variable="publisher"/>
              <text macro="date"/>
            </group>
          </else>
        </choose>
        <text macro="access"/>
      </group>
    </layout>
  </bibliography>
</style>
